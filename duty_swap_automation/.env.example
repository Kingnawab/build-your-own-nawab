# --- LLM used by the CrewAI parser agent (any CrewAI-supported provider works) ---
MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Backend: "graph" (Microsoft 365) or "local" (sample_data/ folder for testing) ---
DUTY_SWAP_BACKEND=graph
# true = read + parse + log what would happen, but do not edit the sheet or send email
DRY_RUN=true
TIMEZONE=America/Los_Angeles

# --- Microsoft Entra ID app registration ---
# "Application (client) ID" from the app's Overview page. This is the only Microsoft value needed for sign-in-once mode.
AZURE_CLIENT_ID=
# Optional for sign-in-once mode (defaults to any work account); required with a client secret.
AZURE_TENANT_ID=
# Leave blank to sign in once yourself with `authorize`. Set only for unattended app-only runs (needs admin consent).
AZURE_CLIENT_SECRET=
# Mailbox to read/send from; only used with a client secret (sign-in-once mode uses whoever signed in)
GRAPH_USER=
GRAPH_TOKEN_CACHE=.graph_token_cache.json

# --- Roster workbook location (pick one) ---
# a) Path inside GRAPH_USER's OneDrive:
ROSTER_FILE_PATH=Documents/Duty Roster.xlsx
# b) SharePoint/Teams document library: set ROSTER_SITE_ID too and ROSTER_FILE_PATH relative to the library root
ROSTER_SITE_ID=
# c) Exact drive item:
ROSTER_DRIVE_ID=
ROSTER_ITEM_ID=

# --- Roster layout ---
ROSTER_SHEET=Roster
ROSTER_DATE_COLUMN=Date
ROSTER_NAME_COLUMN=Assigned
ROSTER_DUTY_COLUMN=Duty
STAFF_SHEET=Staff
STAFF_NAME_COLUMN=Name
STAFF_EMAIL_COLUMN=Email
# Audit trail sheet (leave blank to disable). Must already exist in the workbook.
SWAP_LOG_SHEET=Swap Log

# --- Inbox scanning ---
LOOKBACK_HOURS=72
# Comma-separated; only emails whose subject/body contain one of these go to the AI (blank = all unread mail)
SUBJECT_KEYWORDS=swap,switch,trade,cover,duty

# --- Rules ---
REQUIRE_REQUESTER_IS_PARTY=true
# These senders may request swaps on behalf of others
MANAGER_EMAILS=
# Always CC these addresses on confirmations
NOTIFY_CC=
ALLOW_PAST_DATES=false
